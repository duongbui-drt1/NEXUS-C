{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "MigrationConnection": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "https://nexus-c.local",
    "Audience": "nexus-ecosystem",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "RabbitMQ": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "nexus",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "nexus.events",
    "DeadLetterExchangeName": "nexus.events.dlx"
  },
  "Outbox": {
    "EnableBackgroundProcessor": true,
    "BatchSize": 25,
    "PollIntervalMilliseconds": 2000,
    "MaxRetries": 5
  },
  "ObjectStorage": {
    "Provider": "Local",
    "BucketName": "nexus-files",
    "LocalBasePath": "storage-data",
    "MaxUploadSizeBytes": 26214400,
    "SigningSecret": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "AuthPermitLimit": 30
  },
  "OpenApi": {
    "Enabled": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
