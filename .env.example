# NEXUS C Foundation — Environment Configuration Template
# Copy to .env and populate with strong, unique secrets before starting Docker Compose.
# NEVER commit .env to version control.

ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
OPENAPI_ENABLED=true

# PostgreSQL (use separate migrator and least-privilege app accounts)
POSTGRES_DB=nexus_dev
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_STRONG_MIGRATOR_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=nexus
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_RABBITMQ_PASSWORD

# S3 / MinIO Object Storage
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=nexus-files
S3_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
OBJECT_STORAGE_SIGNING_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HMAC_SECRET

# JWT Security (minimum 64 random bytes recommended)
JWT_ISSUER=https://nexus-c.local
JWT_AUDIENCE=nexus-ecosystem
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_64_CHAR_JWT_SIGNING_KEY

# Optional Bootstrap Platform Admin (set only during initial environment bootstrap)
NEXUS_BOOTSTRAP_ADMIN_EMAIL=admin@nexus.local
NEXUS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_COMPLEX_INITIAL_PASSWORD
